# Copy to .env and fill in. .env is gitignored.

# Supabase — Project Settings > Data API (URL) and API Keys (publishable key)
SUPABASE_URL=
SUPABASE_KEY=
# Never put the SECRET key here — it bypasses RLS and must not ship in the app.

# Dropbox app (Full Dropbox scope — NOT app-folder, see FR-3)
DROPBOX_APP_KEY=
# PKCE flow, no client secret needed on mobile

# The LLM (Groq) and web search (Tavily) keys are NOT stored here anymore — they
# would ship inside the APK. They live in Supabase Edge Function secrets instead:
#   supabase secrets set GROQ_API_KEY=... GROQ_API_KEY_2=... SEARCH_API_KEY=...
# See supabase/functions/README.md.
